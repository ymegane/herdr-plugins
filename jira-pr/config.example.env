# herdr plugin config-dir ymegane.jira-pr が返すディレクトリに config.env として置く
JIRA_BASE_URL="https://your-site.atlassian.net"
JIRA_EMAIL="you@example.com"

# 以下は省略時の既定値
# KEYCHAIN_SERVICE="herdr-jira-pr"
# KEY_PATTERN='[A-Z][A-Z0-9]+-[0-9]+'
# CACHE_TTL_SEC=300
# worktree を開くエディタ。引数を含めて書ける（例: "code"、"open -a Cursor"）
# EDITOR_CMD="zed"
